extends ../../layouts/default.pug
include ../../mixins/alert.pug

block head
  link(rel="stylesheet" href="/css/user.css")

block main
  +alert-error(5000)

  .container.my-5
    .auth-form-wrapper
      h1 Đổi mật khẩu
      form(action="/user/password/reset" method="POST")
        .form-group
          label(for="password") Mật khẩu mới
          input#password.form-control(
            type="password"
            name="password"
            required
          )
        .form-group
          label(for="confirmPassword") Xác nhận mật khẩu
          input#confirmPassword.form-control(
            type="password"
            name="confirmPassword"
            required
          )
        button.btn.btn-primary(type="submit") Đổi mật khẩu
