extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main 
    h1(class="mb-4") Thông tin cá nhân 

    if(user.fullName)
        p Họ tên: <b> #{user.fullName} </b>
    
    if(user.email)
        p Email: <b> #{user.email} </b>
    
    a(
        href=`/user/edit`
        class="btn btn-primary"
    ) Chỉnh sửa thông tin