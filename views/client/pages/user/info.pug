extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block head 
  link(rel="stylesheet" href="/css/infor.css")

block main 
  .profile-container
    h1 Thông tin cá nhân 

    if(user.fullName)
      p Họ tên: <b>#{user.fullName}</b>

    if(user.email)
      p Email: <b>#{user.email}</b>

    a.btn.btn-primary(href="/user/edit") Chỉnh sửa thông tin
