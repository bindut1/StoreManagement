extends ../../layouts/default.pug
include ../../mixins/alert.pug

block head
    link(rel="stylesheet" href="/css/style.css")

block main 
    +alert-error(5000)

    .container.my-5
        .auth-form-wrapper
            h1 Lấy lại mật khẩu
            form(action="/user/password/forgot" method="POST")
                .form-group
                    label(for="email") Email
                    input#email.form-control(type="email" name="email" required)
                button(type="submit" class="btn btn-primary") Gửi mail xác nhận
