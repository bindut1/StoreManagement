extends ../../layouts/default.pug
include ../../mixins/alert.pug

block head
  link(rel="stylesheet" href="/css/user.css")

block main
  +alert-error(5000)

  .container.my-5
    .auth-form-wrapper
      h1 Nhập mã OTP xác thực
      form(action="/user/password/otp" method="POST")
        .form-group
          label(for="email") Email
          input#email.form-control(
            type="email"
            name="email"
            value=email
            required
            readonly
          )
        .form-group
          label(for="otp") Mã OTP
          input#otp.form-control(
            type="text"
            name="otp"
            required
          )
        button.btn.btn-primary(type="submit") Xác nhận
